# ===================================
# WorldDataVision - .gitignore
# ===================================

# ============ Logs ============
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============ OS ============
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# ============ IDE ============
.vscode/
.idea/
*.swp
*.swo
*.swn
.project
.settings/
*.sublime-project
*.sublime-workspace

# ============ Node ============
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.npm
.eslintcache

# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ============ Jupyter ============
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============ Build ============
frontend/build/
backend/build/
dist/
*.min.js
*.min.css

# ============ Données Sensibles ============
.env
.env.local
.env.*.local
backend/.env
*.key
*.pem
*.p12
credentials.json

# ============ Temporaires ============
*.tmp
*.temp
*.cache
.backup/
tmp/

# ============ Datasets Volumineux ============
Data/*.csv
!Data/country-codes*.csv
Data/Age/*.csv
Data/OWID/**/*
*.zip
*.tar.gz
*.rar

# ============ Outputs/Résultats ============
analysis_outputs/*.png
analysis_outputs/*.pdf
!analysis_outputs/.gitkeep

# ============ Base de Données ============
*.db
*.sqlite
*.sqlite3

# ============ Scripts Temporaires ============
test_*.py
temp_*.py
debug_*.js

# ============ Exceptions (à garder) ============
!.gitkeep
!README.md
